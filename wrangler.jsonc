{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-alert-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "secrets": {
    "required": [
      "LINE_CHANNEL_ACCESS_TOKEN",
      "LINE_USER_ID",
      "WEBHOOK_SECRET"
    ]
  }
}
